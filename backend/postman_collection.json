{
  "info": {
    "name": "SU Booking Room - Notification API",
    "description": "API collection for testing notification endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/my",
              "host": ["{{base_url}}"],
              "path": ["notifications", "my"]
            }
          }
        },
        {
          "name": "Get Unread Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/my?unread_only=true&limit=10",
              "host": ["{{base_url}}"],
              "path": ["notifications", "my"],
              "query": [
                {
                  "key": "unread_only",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/1/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", "1", "read"]
            }
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/read-all",
              "host": ["{{base_url}}"],
              "path": ["notifications", "read-all"]
            }
          }
        },
        {
          "name": "Delete Notification",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/1",
              "host": ["{{base_url}}"],
              "path": ["notifications", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Trigger Notifications",
      "item": [
        {
          "name": "Create Booking (→ triggers notification)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": 1,\n  \"booking_date\": \"2026-03-15\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"12:00\",\n  \"title\": \"Test Notification\",\n  \"purpose\": \"Testing email notification system\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": ["{{base_url}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Approve Booking (Admin → triggers notification)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"status_note\": \"Approved by admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/1/status",
              "host": ["{{base_url}}"],
              "path": ["bookings", "1", "status"]
            }
          }
        },
        {
          "name": "Reject Booking (Admin → triggers notification)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"status_note\": \"Room is under maintenance\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookings/1/status",
              "host": ["{{base_url}}"],
              "path": ["bookings", "1", "status"]
            }
          }
        },
        {
          "name": "Cancel Booking (→ triggers notification)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/1/cancel",
              "host": ["{{base_url}}"],
              "path": ["bookings", "1", "cancel"]
            }
          }
        }
      ]
    }
  ]
}
