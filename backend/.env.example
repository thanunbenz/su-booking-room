# Server Configuration
APP_NAME=su-booking-room
APP_ENV=development
APP_PORT=8080
APP_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=booking_room_db
DB_SSL_MODE=disable

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP Email Configuration
# === MailHog (Development - Testing only, no real emails) ===
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SU Booking Room <noreply@silpakorn.edu>

# === Gmail/SMTP (Production - Real emails) ===
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=SU Booking Room <noreply@silpakorn.edu>

# Email Queue Settings
EMAIL_QUEUE_SIZE=100
EMAIL_WORKER_COUNT=3
EMAIL_RETRY_COUNT=3
EMAIL_RETRY_DELAY=5s

# Reminder Settings
REMINDER_ENABLED=true
REMINDER_HOURS_BEFORE=24

# Frontend URL (for email links)
APP_BASE_URL=http://localhost:3000
